// NXP i.MX6 (Cortex-A9) — Paradigm A (Cortex-A Linux SoC). Build #3 (coverage), 2026-06-12.
// auto_match:false (generic ARM DAP) -> --profile imx6. Reuses the generic mem-AP DRAM dump. HW-UNVALIDATED.
{
  "schema_version": 1,
  "name": "NXP i.MX6 (Cortex-A9)",
  "soc": "imx6",
  "paradigm": "A",
  "status": "partial",
  "auto_match": false,
  "match": {
    "family": "arm",
    "part_ids": [],
    "min_taps": 1
  },
  "openocd_cfg": "openocd/imx6.cfg",
  "access_check": "openocd/jtag-access-check.tcl",
  "enumerate": null,
  "dump": {
    "dram": {
      "script": "openocd/dump-os-ddr.tcl",
      "addr": "0x10000000",
      "size": "0x40000000",
      "sparse": true,
      "out": "dumps/os-live.bin"
    },
    "flash": null
  },
  "reopen": [],
  "absent": {
    "enumerate": "no on-DAP vendor posture register set characterized (HAB secure boot is in fuses/BootROM)",
    "flash": "boot flash (SD/eMMC/QSPI via the SoC boot ROM) reflash is media-specific \u2014 not wired; DRAM is the JTAG value",
    "reopen": "secure-boot/debug gating is eFuse \u2014 no live register reopen lever"
  },
  "patch": {
    "script": "openocd/probe-phys-patch.tcl",
    "pa_math": "virt2phys",
    "kva_lo": "0x00000000",
    "env": {
      "PATCH_CORE": "imx6.cpu.0",
      "PATCH_AXI": "imx6.axi",
      "PATCH_DAP": "imx6.dap"
    }
  },
  "reflash": {
    "repack": false,
    "note": "reflash by writing the patched boot image to the SD/eMMC/QSPI boot media directly (media-specific)."
  },
  "analysis": [
    {
      "tool": "tools/dram-secrets.py",
      "on": "dram"
    }
  ],
  "ghidra": "auto",

  // --- per-board adapter allowlist. Cortex-A9 DAP over JTAG; tier e. ---
  "adapters": [
    { "id": "ftdi",      "name": "Generic FTDI / Digilent", "backend": "openocd", "driver": "ftdi",      "transports": ["jtag"], "usb_ids": ["0403:6010", "0403:6014"], "tier": "e", "vendor_sw": false, "note": "Default open path over the i.MX6 JTAG header." },
    { "id": "jlink",     "name": "SEGGER J-Link",           "backend": "openocd", "driver": "jlink",     "transports": ["jtag"], "usb_ids": ["1366:0101"],              "tier": "e", "vendor_sw": false, "note": "ARM DAP run-control + mem-AP DRAM dump." },
    { "id": "cmsis-dap", "name": "ARM CMSIS-DAP / DAPLink",  "backend": "openocd", "driver": "cmsis-dap", "transports": ["jtag"], "usb_ids": [],                         "tier": "e", "vendor_sw": false, "note": "Any CMSIS-DAP probe over JTAG." }
  ]
}
