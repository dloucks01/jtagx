// Espressif ESP32 (Xtensa) — Paradigm C. Build #3, 2026-06-12. --profile esp32. Stock OpenOCD has the
// xtensa target; JTAG gives RAM + debug. Flash + eFuse posture = esptool.py / espefuse.py (Espressif). HW-UNVALIDATED.
{
  "schema_version": 1,
  "name": "Espressif ESP32 (Xtensa LX6)",
  "soc": "esp32",
  "paradigm": "C",
  "status": "partial",
  "auto_match": false,
  "match": {
    "family": "xtensa",
    "part_ids": [],
    "min_taps": 1
  },
  "openocd_cfg": "openocd/esp32.cfg",
  "access_check": null,
  "enumerate": null,
  "dump": {
    "dram": {
      "script": "openocd/dump-os-ddr.tcl",
      "addr": "0x3FFB0000",
      "size": "0x50000",
      "sparse": false,
      "out": "dumps/esp32-ram.bin"
    },
    "flash": null
  },
  "reopen": [],
  "absent": {
    "enumerate": "secure-boot / flash-encryption posture is in eFuses \u2014 read with espefuse.py 'summary' (Espressif tool)",
    "flash": "external SPI flash \u2014 dump with esptool.py 'read_flash 0 0x400000 flash.bin' (Espressif tool); the JTAG path gives RAM + debug",
    "reopen": "JTAG-disable / secure-boot are eFuses \u2014 no live reopen"
  },
  "patch": null,
  "analysis": [
    {
      "tool": "tools/dram-secrets.py",
      "on": "dram"
    }
  ],
  "ghidra": "auto",

  // --- per-board adapter allowlist. Paradigm C (Xtensa): JTAG gives RAM + run-control (tier e); external SPI flash = esptool. ---
  "adapters": [
    { "id": "ftdi",             "name": "Generic FTDI / ESP-Prog",          "backend": "openocd", "driver": "ftdi",         "transports": ["jtag"], "usb_ids": ["0403:6010"], "tier": "e", "vendor_sw": false, "note": "4-wire JTAG to the ESP32; ESP-Prog is Espressif's FT2232 board. RAM dump + run-control; external SPI flash via esptool.py." },
    { "id": "builtin-usb-jtag", "name": "ESP built-in USB-JTAG (S3/C3/C6)", "backend": "openocd", "driver": "esp_usb_jtag", "transports": ["jtag"], "usb_ids": ["303a:1001"], "tier": "e", "vendor_sw": false, "note": "Built into ESP32-S3/C3/C6 — NOT the classic LX6 ESP32; listed for the family." }
  ]
}
