// Microchip SAM D5x/E5x (Cortex-M4) — Paradigm B (Cortex-M). Build "more families" 2026-06-11. auto_match:false -> --profile samd5x.
// Debug-access protection via DSU.STATUSB.PROT.  HW-UNVALIDATED; addresses cited in openocd/cortexm-protect.tcl + docs/25.
{
  "schema_version": 1,
  "name": "Microchip SAM D5x/E5x (Cortex-M4)",
  "soc": "samd5x",
  "paradigm": "B",
  "status": "partial",
  "auto_match": false,
  "match": { "family": "arm", "part_ids": [], "min_taps": 1 },

  "openocd_cfg": "openocd/cortexm-samd5x.cfg",
  "access_check": null,
  "enumerate": { "script": "openocd/cortexm-protect.tcl", "interpret": false },
  "dump": {
    "dram": null,
    "flash": { "script": "openocd/cortexm-dump.tcl", "out": "dumps/cortexm-flash.bin",
               "note": "Internal flash + SRAM via the mem-AP. Constants from the cfg.", "env": {} }
  },
  "reopen": [],
  "absent": { "reopen": "no non-destructive reopen — DSU debug-protection clears only via a chip-erase (WIPES flash)" },
  "patch": { "script": "openocd/probe-phys-patch.tcl", "pa_math": "linear", "kva_lo": "0x00000000",
             "env": { "PATCH_CORE": "atsame5.cpu", "PATCH_AXI": "atsame5.cpu", "PATCH_DAP": "atsame5.dap" } },
  "reflash": { "repack": false, "script": "openocd/cortexm-flash.tcl",
               "env": { "CMF_FILE": "dumps/cortexm-flash-patched.bin" },
               "note": "Reflash internal flash via OpenOCD's driver. DESTRUCTIVE; part must be RDP-0 / APPROTECT-off." },
  "analysis": [ { "tool": "tools/dram-secrets.py", "on": "flash" } ],
  "ghidra": "auto"
}
