// Nordic nRF52 (Cortex-M4 MCU, BLE SoC) — Paradigm B. Build #5, 2026-06-11.
// auto_match:false — select with --profile nrf52. Gate = APPROTECT (UICR). If APPROTECT is truly
// enabled the AHB-AP is blocked and only the CTRL-AP (mass-erase) remains; so if you can read flash
// at all, the part is open this session. Defaults sized for nRF52840; for 52832 see the cfg.
// HW-UNVALIDATED (no MCU on the bench).
{
  "schema_version": 1,
  "name": "Nordic nRF52 (Cortex-M4)",
  "soc": "nrf52",
  "paradigm": "B",
  "status": "partial",
  "auto_match": false,
  "match": { "family": "arm", "part_ids": [], "min_taps": 1 },

  "openocd_cfg": "openocd/cortexm-nrf52.cfg",
  "access_check": null,
  "enumerate": { "script": "openocd/cortexm-protect.tcl", "interpret": false },

  "dump": {
    "dram": null,
    "flash": { "script": "openocd/cortexm-dump.tcl", "out": "dumps/cortexm-flash.bin",
               "note": "Internal flash (0x00000000) + SRAM via the mem-AP. Constants from the cfg.", "env": {} }
  },

  "reopen": [],
  "absent": { "reopen": "no non-destructive reopen — APPROTECT clears only via a CTRL-AP mass-erase (wipes flash)" },
  "patch": { "script": "openocd/probe-phys-patch.tcl", "pa_math": "linear", "kva_lo": "0x00000000",
             "env": { "PATCH_CORE": "nrf52.cpu", "PATCH_AXI": "nrf52.cpu", "PATCH_DAP": "nrf52.dap" } },

  "reflash": { "repack": false, "script": "openocd/cortexm-flash.tcl",
               "env": { "CMF_FILE": "dumps/cortexm-flash-patched.bin" },
               "note": "Reflash internal flash via OpenOCD's driver. DESTRUCTIVE; part must be RDP-0 / APPROTECT-off." },
  "analysis": [ { "tool": "tools/dram-secrets.py", "on": "flash" } ],
  "ghidra": "auto"
}
